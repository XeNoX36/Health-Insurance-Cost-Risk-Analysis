            </column>
            <column caption='Radial-Points' datatype='integer' name='[Calculation_1264201132314626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;1&quot;) THEN 0 ELSE 270 END' />
            </column>
            <column caption='Smoking Category LOD' datatype='integer' name='[Calculation_1264201133551619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [smoking_status]: SUM([insurance_cost])}' />
            </column>
            <column caption='Radial-Rank' datatype='integer' name='[Calculation_1264201134088196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(-SUM([Calculation_1264201133551619]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Radial-X' datatype='real' name='[Calculation_1264201134546949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIN((INDEX()-1)*WINDOW_MAX(MAX(PI()))/180)*WINDOW_MAX([Calculation_1264201134088196])'>
