      <column caption='Delta Fig-Avg Insur (▲) ' datatype='string' name='[Delta Arrow-Avg Insur (▲) (copy)_1258154629775374]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([insurance_cost]) &gt; SUM([Fixed Total Ins. (copy)_1258154590584835]) THEN &#13;&#10;str(ROUND([Delta-Avg Ins. (copy)_1100100093468673], 1))+&quot;%&quot; &#13;&#10;ELSE &quot; &quot; END' />
