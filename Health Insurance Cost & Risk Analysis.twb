            <column caption='Radial-Y' datatype='real' name='[Radial-X (copy)_1264201135779847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COS((INDEX()-1)*WINDOW_MAX(MAX(PI()))/180)*WINDOW_MAX([Calculation_1264201134088196])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
