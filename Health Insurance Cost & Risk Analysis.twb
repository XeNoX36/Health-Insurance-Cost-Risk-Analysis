            <column caption='Delta-Total Ins.' datatype='real' name='[Total Ins. Delta (copy)_0328517081673730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-((SUM([Calculation_0328517076459521])-SUM([insurance_cost]))/SUM([Calculation_0328517076459521]))' />
